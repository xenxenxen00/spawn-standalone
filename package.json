{
  "name": "spawn-standalone",
  "version": "0.0.0",
  "private": true,
  "description": "Game-independent Spawn-compatible runtime, converter, Vite adapter and synthetic testing fixtures",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node tools/check/source-rules.ts",
    "test": "vitest run",
    "check": "npm run build:packages && npm run typecheck && npm run lint && npm test",
    "build:packages": "node tools/release/build.ts",
    "release:check": "node tools/release/verify.ts",
    "audit:source": "node tools/check/source-audit.ts"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/sql.js": "1.4.11",
    "@types/three": "0.186.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "js-yaml": "5.4.3",
    "jsdom": "30.1.2",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "sql.js": "1.15.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "0.21.0",
    "@playgama/bridge": "2.3.1",
    "fflate": "0.8.3",
    "idiomorph": "0.8.0",
    "three": "0.186.1"
  }
}
